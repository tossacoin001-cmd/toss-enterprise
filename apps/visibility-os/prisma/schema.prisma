generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  // Migrations must not go through the transaction pooler (POSTGRES_URL):
  // prisma migrate hangs on its session locks there. The non-pooling URL
  // is session-capable and only fails when the database is suspended.
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id         String     @id
  email      String     @unique
  name       String?
  plan       Plan       @default(FREE)
  // Set when a weekly run finishes for this user; the cron skips anyone run in the last 6 days.
  lastDigestAt  DateTime?
  digestOptOut  Boolean    @default(false)
  // Short lease taken while the weekly run works on this user, so overlapping runs cannot both email them.
  weeklyClaimAt DateTime?
  // The seven-day workspace trial. Set once, the first time the account uses its workspace; never reset.
  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  businesses Business[]
  subscription Subscription?
}

model Business {
  id              String            @id @default(cuid())
  name            String
  category        String?
  city            String?
  country         String            @default("NG")
  googlePlaceId   String?
  googleBizUrl    String?
  phoneNumber     String?
  website         String?
  instagramHandle String?
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  visibilityScores VisibilityScore[]
  actionItems     ActionItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
}

model VisibilityScore {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  total        Int
  googleScore  Int      @default(0)
  socialScore  Int      @default(0)
  websiteScore Int      @default(0)
  reviewCount  Int      @default(0)
  avgRating    Float    @default(0)
  // This week's findings, kept so next week can say what changed (the weekly watch).
  findings     Json?
  recordedAt   DateTime @default(now())

  @@index([businessId])
}

model ActionItem {
  id          String       @id @default(cuid())
  businessId  String
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    Priority     @default(MEDIUM)
  status      ActionStatus @default(PENDING)
  category    String?
  // The finding this item came from, so a rescan updates the item instead of duplicating it. Null on items made before keys existed.
  key         String?
  // The owner's own words about this action.
  note        String?
  completedAt DateTime?
  // Set when the owner marked it done but a fresh check still found the problem. Cleared when the check passes or the item is reopened.
  lastSeenFailingAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([businessId, key])
  @@index([businessId])
}

// One subscription per account, moved only by verified, de-duplicated provider events.
model Subscription {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // STARTER, GROWTH or AGENCY, checked in code. Plain text on purpose: production has no database type for plans.
  plan              String
  // MONTHLY or ANNUAL: what was paid for, which sets the length of the period.
  interval          String   @default("MONTHLY")
  status            String
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// One row per weekly run: when it ran and what it did, so a missed or partial run can be seen.
model WeeklyRun {
  id               String    @id @default(cuid())
  startedAt        DateTime
  finishedAt       DateTime?
  usersProcessed   Int       @default(0)
  emailsSent       Int       @default(0)
  skippedNoEmail   Int       @default(0)
  skippedOptedOut  Int       @default(0)
  skippedClaimed   Int       @default(0)
  failed           Int       @default(0)
  budgetExhausted  Boolean   @default(false)

  @@index([startedAt])
}

// Every provider event we have handled, so a repeat delivery changes nothing.
model BillingEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  type       String
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
}

enum Plan {
  FREE
  STARTER
  GROWTH
  AGENCY
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ActionStatus {
  PENDING
  IN_PROGRESS
  DONE
}

// A free instant scan (no sign-up). Holds no network address: visitorHash uses a daily-changing salt.
model Scan {
  id              String   @id
  siteKey         String?
  url             String?
  visitorHash     String
  status          String   @default("running")
  result          Json?
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  claimedByUserId String?

  @@index([siteKey, createdAt])
  @@index([visitorHash, createdAt])
  @@index([createdAt])
  @@index([expiresAt])
}

# Clerk authentication (dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Postgres via the Vercel + Supabase integration. Prisma reads these names
# directly (schema.prisma): pooled URL for queries, non-pooling URL for
# migrations (prisma migrate hangs on the transaction pooler).
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Clerk webhook signing secret (Svix). The code reads CLERK_WEBHOOK_SECRET.
CLERK_WEBHOOK_SECRET=

# Places API (New), console.cloud.google.com. Server-only: powers the
# onboarding business search and live review/rating data. Autocomplete and
# scoring degrade gracefully (no suggestions, Google score 0) when unset.
GOOGLE_PLACES_API_KEY=

# Shared secret Vercel sends back as `Authorization: Bearer $CRON_SECRET`
# when it invokes /api/cron/weekly-score (daily; each user is processed once
# every 6+ days). Also signs the email unsubscribe links. Required; the cron
# route always 401s without it. Generate any long random string.
CRON_SECRET=

# Resend (resend.com). Powers the weekly digest email. Shares the same
# account/key apps/website uses; sending degrades gracefully (email skipped,
# logged) when unset. See @toss/email in packages/.
RESEND_API_KEY=

# Sender for the weekly digest, e.g. "Visibility OS <hello@tossvisibilityos.com>".
# Set only after the domain is verified in Resend; unset falls back to Resend's
# shared onboarding@resend.dev, which only delivers to your own account.
EMAIL_FROM=

# Public origin used in email links. Defaults to https://tossvisibilityos.com.
APP_URL=

# Clerk authentication (dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Postgres via the Vercel + Supabase integration. Prisma reads these names
# directly (schema.prisma): transaction pooler for queries, session pooler
# for migrations (the non-pooling direct host is IPv6-only and unreachable
# from Vercel builds).
POSTGRES_PRISMA_URL=
POSTGRES_URL=

# Clerk webhook signing secret (Svix). The code reads CLERK_WEBHOOK_SECRET.
CLERK_WEBHOOK_SECRET=

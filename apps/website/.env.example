# Contact form backend: Resend sends the lead notification email, MongoDB
# persists a queryable record. Server-only, never exposed to the client.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL=
MONGODB_URI=
MONGODB_DB=

# Optional overrides. Code defaults live in lib/config.ts; leave empty to use them.
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_FLUTTERWAVE_URL=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=
